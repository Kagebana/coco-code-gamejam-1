  m_TableData:
  - m_Id: 98056589312
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 145863266304
    m_Localized: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 195792261120
    m_Localized: "\u041E\u0431 \u0438\u0433\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1885044002816
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3515051200512
    m_Localized: "\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\nKagebana\n\n\u0418\u0434\u0435\u044F\nZweifel\n\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435
      \u0430\u0441\u0441\u0435\u0442\u044B\n\u0421\u043F\u0440\u0430\u0439\u0442\u044B\nAnokolisa,
      9E0, kaiowoka, SHMORGUS, Danaida\n\n\u041C\u0443\u0437\u044B\u043A\u0430\nxDeviruchi\n\n\u0417\u0432\u0443\u043A\u0438\nJDWasabi,
      DASK"
    m_Metadata:
      m_Items: []
  - m_Id: 4156028932096
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 4317257977856
    m_Localized: "\u041B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 4451538620416
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 14226020159488
    m_Localized: "\u042F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043A\u043B\u044E\u0447\u0438
      \u043E\u0442 \u043A\u0443\u0445\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 14319691550720
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043C\u043D\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0432 \u043A\u043E\u0442\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 14420891717632
    m_Localized: "\u042D\u0442\u043E \u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043B\u044F
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 14533500391424
    m_Localized: "\u042F \u0445\u043E\u0442\u0435\u043B\u0430 \u043E\u0442\u0433\u043E\u0440\u043E\u0434\u0438\u0442\u044C
      \u043A\u0430\u0436\u0434\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 14682314297344
    m_Localized: "\u041D\u043E \u043F\u0440\u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
      \u0440\u044B\u0447\u0430\u0433\u0430 \u043D\u0430 \u044D\u0442\u0443 \u0434\u0432\u0435\u0440\u044C
      \u0440\u044B\u0447\u0430\u0433 \u0441\u043B\u043E\u043C\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 14777474666496
    m_Localized: "\u042F \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u043E\u0442\u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 14822445993984
    m_Localized: "\u0412 \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u0442\u0443\u043F\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 14962154065920
    m_Localized: "\u0418 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0435
      \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u0446\u0432\u0435\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 15175547670528
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0437\u0434\u0435\u0441\u044C
      \u0431\u044B\u043B\u0430 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 15287908880384
    m_Localized: "\u041D\u043E \u043F\u043E\u043B \u0431\u044B\u043B \u0434\u043B\u044F
      \u043C\u0435\u043D\u044F \u0432\u0430\u0436\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 15353096753152
    m_Localized: "\u041F\u043E\u0434\u0432\u0430\u043B \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 18997590413312
    m_Localized: "\u041E\u0433\u043E, \u0442\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F! \u0414\u0430\u0432\u0430\u0439-\u043A\u0430
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 19115190308864
    m_Localized: "\u2026\u0422\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E?
      \u042D\u0442\u043E \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 19214108774400
    m_Localized: "\u041E\u0445, \u043D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E!
      \u0410 \u0434\u0430\u0432\u0430\u0439 \u0435\u0449\u0451 \u0432\u043E\u0434\u044B
      \u0434\u043E\u0431\u0430\u0432\u0438\u043C, \u043C\u043E\u0436\u0435\u0442,
      \u0441\u043E\u0432\u0441\u0435\u043C \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C
      \u0441\u0442\u0430\u043D\u0435\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 19376923267072
    m_Localized: "\u042D\u0445, \u043B\u0430\u0434\u043D\u043E\u2026 \u0418\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u043E\u0448\u0438\u0431\u043A\u0438 \u043D\u0443\u0436\u043D\u043E <color=black>\u043D\u0430
      \u043C\u0435\u0441\u0442\u0435</color>."
    m_Metadata:
      m_Items: []
  - m_Id: 20760766763008
    m_Localized: "\u0425\u0435\u0439, \u043C\u0430\u043B\u044F\u0432\u043A\u0430.
      \u0422\u044B \u0442\u0443\u0442 \u043E\u0434\u043D\u0430, \u0438\u043B\u0438
      \u043C\u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 20884641337344
    m_Localized: "\u0425\u043E\u0442\u044F, \u0435\u0441\u043B\u0438 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C\u2026
      \u043E\u0442 \u043A\u043E\u0433\u043E \u0442\u0443\u0442 \u043E\u0436\u0438\u0434\u0430\u0442\u044C
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438? \u041E\u0442 \u0442\u043E\u0439
      \u0447\u0430\u0445\u043B\u043E\u0439 \u043A\u0440\u044B\u0441\u044B \u0437\u0430
      \u0443\u0433\u043B\u043E\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 20968762298368
    m_Localized: "\u0425\u0435-\u0445\u0435\u2026 \u0445\u043E\u0442\u044F \u043A\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442, \u043C\u043E\u0436\u0435\u0442, \u043E\u043D\u0430
      \u0442\u043E\u0436\u0435 \u0432\u0430\u0440\u0438\u0442 \u0437\u0435\u043B\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21044993773568
    m_Localized: "\u0422\u0430\u043A \u0432\u043E\u0442. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C \u0442\u0440\u0430\u0432\u0438\u0442\u044C,
      \u0430 \u043D\u0435 \u043A\u043E\u0440\u043C\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 21147838107648
    m_Localized: "\u042D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E. \u041B\u044E\u0431\u043B\u044E
      \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0440\u0430\u0437\u0443 \u0437\u043D\u0430\u044E\u0442, \u0447\u0435\u043C
      \u0443\u0434\u0438\u0432\u0438\u0442\u044C \u0433\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 21213034369024
    m_Localized: "\u0425\u043E\u0442\u044F\u2026 \u0441\u043A\u0430\u0436\u0438 \u043C\u043D\u0435
      \u0447\u0435\u0441\u0442\u043D\u043E, \u0442\u044B \u0443\u0432\u0435\u0440\u0435\u043D\u0430,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u0434\u0435\u043B\u0430\u0435\u0448\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 21266385915904
    m_Localized: "\u0418\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0438\u0434\u0430\u0435\u0448\u044C
      \u0432\u0441\u0451 \u043F\u043E\u0434\u0440\u044F\u0434, \u043F\u043E\u043A\u0430
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0432\u0437\u043E\u0440\u0432\u0451\u0442\u0441\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 21321780088832
    m_Localized: "\u041B\u0430\u0434\u043D\u043E-\u043B\u0430\u0434\u043D\u043E,
      \u043D\u0435 \u0437\u043B\u0438\u0441\u044C. \u0412\u0441\u0451 \u043F\u0440\u043E\u0441\u0442\u043E.
      \u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u0440\u0435\u0446\u0435\u043F\u0442\u044B.
      \u0414\u0432\u0430. \u041E\u0434\u0438\u043D \u0441\u043B\u0430\u0431\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 21461035175936
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0439\u2026 \u043D\u0443, \u0441\u043A\u0430\u0436\u0435\u043C,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u043E\u0441\u043B\u0435
      \u0441\u0435\u0431\u044F \u043C\u0430\u043B\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 21552802353152
    m_Localized: "\u0412\u0441\u0451 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 <color=yellow>\u0437\u043E\u043B\u043E\u0442\u043E\u0433\u043E</color>
      \u0446\u0432\u0435\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21711212826624
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2013 \u043D\u0435
      \u043F\u0443\u0442\u0430\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A.
      <color=red>\u041A\u0440\u0430\u0441\u043D\u043E\u0435</color>, <color=purple>\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u043E\u0435</color>,
      <color=green>\u0437\u0435\u043B\u0451\u043D\u043E\u0435</color>, <color=green>\u0437\u0435\u043B\u0451\u043D\u043E\u0435</color>
      \u2013 \u0432\u0441\u0451 \u0438\u043C\u0435\u0435\u0442 \u0441\u043C\u044B\u0441\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22213619142656
    m_Localized: "\u041D\u043E \u0432\u043E\u0442 \u0447\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u2026
      \u0435\u0441\u043B\u0438 \u043E\u0448\u0438\u0431\u0451\u0448\u044C\u0441\u044F\u2026
      \u0445\u0435-\u0445\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22271290822656
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u0442\u044B \u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u043F\u0435\u0440\u0432\u044B\u043C, \u043A\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u0442
      \u0441\u0432\u043E\u0451 \u0436\u0435 \u0432\u0430\u0440\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22362558877696
    m_Localized: "\u0418 \u044D\u0442\u043E \u043D\u0435 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442
      \u0448\u0435\u0444-\u043F\u043E\u0432\u0430\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 22450073030656
    m_Localized: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C, \u0431\u0443\u0434\u044C
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0432\u0435\u0434\u044C\u043C\u043E\u0439
      \u0438 \u0441\u0432\u0430\u0440\u0438 \u043C\u043D\u0435 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C\u2026
      \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0435. \u041E\u0431\u044B\u0447\u043D\u044B\u0439
      \u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 22573486231552
    m_Localized: "\u0411\u0435\u0437 \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432,
      \u043B\u0430\u0434\u043D\u043E? \u0423 \u043C\u0435\u043D\u044F \u043F\u043B\u0430\u043D\u044B
      \u043D\u0430 \u0432\u0435\u0447\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 23873179406336
    m_Localized: "\u0425\u0435-\u0445\u0435\u2026 \u043D\u0443 \u043D\u0430\u0434\u043E
      \u0436\u0435. \u0422\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 23952330117120
    m_Localized: "\u0410 \u044F \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B
      \u0434\u0443\u043C\u0430\u0442\u044C, \u0447\u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0441\u0430\u043C\u043E\u043C\u0443 \u0438\u0441\u043A\u0430\u0442\u044C \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 24012199612416
    m_Localized: "\u0410 \u0437\u043D\u0430\u0435\u0448\u044C\u2026 \u043C\u043D\u0435
      \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 24067086274560
    m_Localized: "\u0414\u043E\u043B\u0436\u0435\u043D \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u043F\u0430\u0445\u043D\u0435\u0442\u2026 \u043A\u0445\u043C\u2026 \u043E\u0431\u0435\u0449\u0430\u044E\u0449\u0435.
      \u041D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0435\u0434\u043A\u043E,
      \u043D\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043B\u0430\u0431\u043E.
      \u0422\u043E, \u0447\u0442\u043E \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 24130269270016
    m_Localized: "\u0412\u0438\u0436\u0443, \u0442\u044B \u0443\u043C\u0435\u0435\u0448\u044C
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C. \u042D\u0442\u043E \u0440\u0435\u0434\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A, \u0437\u043D\u0430\u0435\u0448\u044C \u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 24181741768704
    m_Localized: "\u0422\u0430\u043A \u0447\u0442\u043E, \u0441\u043A\u0430\u0436\u0438
      \u043C\u043D\u0435\u2026 \u041A\u0430\u043A\u043E\u0432\u043E \u044D\u0442\u043E
      - \u0434\u0435\u043B\u0430\u0442\u044C \u044F\u0434? \u041F\u043E\u043D\u0438\u043C\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u0430\u044F \u043A\u0430\u043F\u043B\u044F
      - \u044D\u0442\u043E \u0447\u0435\u0439-\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0432\u0434\u043E\u0445?"
    m_Metadata:
      m_Items: []
  - m_Id: 24284699348992
    m_Localized: "\u0427\u0442\u043E \u043D\u0430 \u043A\u043E\u043D\u0447\u0438\u043A\u0435
      \u0442\u0432\u043E\u0435\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u0430 \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0447\u0443\u0436\u0430\u044F \u0441\u0443\u0434\u044C\u0431\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 24356174483456
    m_Localized: "\u2026\u041B\u0430\u0434\u043D\u043E, \u043D\u0435 \u0431\u0435\u0440\u0438
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0443. \u042F \u0432\u0435\u0434\u044C
      \u043F\u0440\u043E\u0441\u0442\u043E \u0448\u0443\u0447\u0443. \u041F\u0440\u0430\u0432\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 24413938438144
    m_Localized: "\u0412 \u043B\u044E\u0431\u043E\u043C \u0441\u043B\u0443\u0447\u0430\u0435,
      \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C.
      \u042D\u0442\u043E \u0431\u044B\u043B\u043E\u2026 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E.
      \u041C\u043E\u0436\u0435\u0442, \u0434\u0430\u0436\u0435 \u0437\u0430\u0433\u043B\u044F\u043D\u0443
      \u043A \u0442\u0435\u0431\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 24478832709632
    m_Localized: "\u0410 \u043C\u043E\u0436\u0435\u0442, \u0442\u044B \u043F\u043E\u0436\u0430\u043B\u0435\u0435\u0448\u044C,
      \u0447\u0442\u043E \u044F \u044D\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 28612554182656
    m_Localized: "\u042D\u0419, \u0422\u042B!"
    m_Metadata:
      m_Items: []
  - m_Id: 28690794729472
    m_Localized: "\u0414\u0423\u041C\u0410\u0415\u0428\u042C, \u041C\u041E\u0416\u0415\u0428\u042C
      \u041F\u0420\u041E\u0421\u0422\u041E \u0422\u0410\u041A \u0412\u0417\u042F\u0422\u042C
      \u0418 \u0421\u0412\u0410\u0420\u0418\u0422\u042C \u0421\u0418\u041B\u042C\u041D\u0415\u0419\u0428\u0418\u0419
      \u042F\u0414?! \u0425\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 28807895502848
    m_Localized: "\u042D\u0422\u041E \u041D\u0415 \u041F\u0420\u041E\u0421\u0422\u0410\u042F
      \u0412\u0410\u0420\u041A\u0410! \u042D\u0422\u041E \u0418\u0421\u041F\u042B\u0422\u0410\u041D\u0418\u0415!"
    m_Metadata:
      m_Items: []
  - m_Id: 28916595085312
    m_Localized: "\u0422\u041E\u041B\u042C\u041A\u041E \u0422\u041E\u0422, \u041A\u0422\u041E
      \u041D\u0415 \u041F\u041E\u0411\u041E\u0418\u0422\u0421\u042F \u0416\u0415\u0427\u042C\u0421\u042F,
      \u0421\u041C\u041E\u0416\u0415\u0422 \u041E\u0412\u041B\u0410\u0414\u0415\u0422\u042C
      \u042D\u0422\u041E\u0419 \u0421\u0418\u041B\u041E\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 29206673149952
    m_Localized: "\u0421\u041B\u0423\u0428\u0410\u0419 \u0412\u041D\u0418\u041C\u0410\u0422\u0415\u041B\u042C\u041D\u041E!
      \u0422\u042B \u041D\u0415 \u041C\u041E\u0416\u0415\u0428\u042C \u041F\u0420\u041E\u0421\u0422\u041E
      \u0411\u0420\u041E\u0421\u0410\u0422\u042C \u0418\u041D\u0413\u0420\u0415\u0414\u0418\u0415\u041D\u0422\u042B
      \u041D\u0410\u0423\u0413\u0410\u0414, \u041A\u0410\u041A \u041A\u0410\u041A\u041E\u0419-\u041D\u0418\u0411\u0423\u0414\u042C
      \u0413\u041B\u0423\u041F\u042B\u0419 \u0413\u041E\u0411\u041B\u0418\u041D!"
    m_Metadata:
      m_Items: []
  - m_Id: 29277070348288
    m_Localized: "\u041D\u0415\u0422! \u0422\u042B \u0414\u041E\u041B\u0416\u041D\u0410
      \u0414\u0415\u0419\u0421\u0422\u0412\u041E\u0412\u0410\u0422\u042C \u0422\u041E\u0427\u041D\u041E!
      \u041F\u041E \u041E\u0420\u0414\u0415\u0420\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 29426349821952
    m_Localized: "\u041F\u041E\u0411\u0415\u0414\u0410 \u041F\u0420\u0418\u0425\u041E\u0414\u0418\u0422
      \u0422\u041E\u041B\u042C\u041A\u041E \u041A \u0422\u0415\u041C, \u041A\u0422\u041E
      \u0421\u041B\u0415\u0414\u0423\u0415\u0422 \u041F\u0420\u0410\u0412\u0418\u041B\u042C\u041D\u041E\u0419
      \u0421\u0422\u0420\u0410\u0422\u0415\u0413\u0418\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 29490887577600
    m_Localized: "<color=purple>\u0424\u0418\u041E\u041B\u0415\u0422\u041E\u0412\u042B\u0419</color>,
      <color=red>\u041A\u0420\u0410\u0421\u041D\u042B\u0419</color>, <color=red>\u041A\u0420\u0410\u0421\u041D\u042B\u0419</color>,
      <color=purple>\u0424\u0418\u041E\u041B\u0415\u0422\u041E\u0412\u042B\u0419</color>,
      <color=green>\u0417\u0415\u041B\u0401\u041D\u042B\u0419</color>!"
    m_Metadata:
      m_Items: []
  - m_Id: 29768013631488
    m_Localized: "\u0415\u0421\u041B\u0418 \u0421\u0414\u0415\u041B\u0410\u0415\u0428\u042C
      \u0412\u0421\u0401 \u041F\u0420\u0410\u0412\u0418\u041B\u042C\u041D\u041E -
      \u041F\u041E\u041B\u0423\u0427\u0418\u0428\u042C \u0421\u0418\u041B\u042C\u041D\u0415\u0419\u0428\u0418\u0419
      \u042F\u0414, \u0421\u041F\u041E\u0421\u041E\u0411\u041D\u042B\u0419 \u0421\u041B\u041E\u041C\u0418\u0422\u042C
      \u041B\u042E\u0411\u041E\u0413\u041E!"
    m_Metadata:
      m_Items: []
  - m_Id: 29875933073408
    m_Localized: "\u041D\u041E \u0415\u0421\u041B\u0418 \u041E\u0428\u0418\u0411\u0401\u0428\u042C\u0421\u042F\u2026
      \u0422\u041E \u0422\u042B \u0421\u0422\u0410\u041D\u0415\u0428\u042C \u0415\u0413\u041E
      \u041F\u0415\u0420\u0412\u041E\u0419 \u0416\u0415\u0420\u0422\u0412\u041E\u0419!"
    m_Metadata:
      m_Items: []
  - m_Id: 29970845978624
    m_Localized: "\u0422\u0415\u041F\u0415\u0420\u042C \u0414\u0410\u0412\u0410\u0419!
      \u0414\u041E\u041A\u0410\u0416\u0418, \u0427\u0422\u041E \u0422\u042B \u041D\u0415
      \u0421\u041B\u0410\u0411\u0410\u041A! \u0421\u0412\u0410\u0420\u0418 \u042D\u0422\u041E\u0422
      \u042F\u0414!"
    m_Metadata:
      m_Items: []
  - m_Id: 30641087369216
    m_Localized: "\u0425\u0410-\u0425\u0410-\u0425\u0410! \u0412\u041E\u0422 \u042D\u0422\u041E
      \u0414\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 30895539015680
    m_Localized: "\u0422\u042B \u0421\u0414\u0415\u041B\u0410\u041B\u0410 \u042D\u0422\u041E!
      \u041D\u0410\u0421\u0422\u041E\u042F\u0429\u0418\u0419, \u041C\u041E\u0429\u041D\u042B\u0419,
      \u041D\u0415\u041E\u0421\u0422\u0410\u041D\u041E\u0412\u0418\u041C\u042B\u0419
      \u042F\u0414!"
    m_Metadata:
      m_Items: []
  - m_Id: 30975570530304
    m_Localized: "\u041F\u0420\u042F\u041C\u041E \u041A\u0410\u041A \u041D\u0410\u0421\u0422\u041E\u042F\u0429\u0418\u0419
      \u0411\u041E\u0415\u0412\u041E\u0419 \u042D\u041B\u0418\u041A\u0421\u0418\u0420!
      \u0415\u0421\u041B\u0418 \u042D\u0422\u041E \u041E\u0420\u0423\u0416\u0418\u0415
      \u041F\u041E\u041F\u0410\u0414\u0401\u0422 \u0412 \u0420\u0423\u041A\u0418
      \u041D\u0415\u0414\u041E\u0421\u0422\u041E\u0419\u041D\u042B\u0425\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 31037621063680
    m_Localized: "\u0425\u0410, \u0414\u0410 \u041A\u041E\u041C\u0423 \u042F \u0412\u0420\u0423?!
      \u041E\u041D\u0418 \u041D\u0415 \u0412\u042B\u0416\u0418\u0412\u0423\u0422!"
    m_Metadata:
      m_Items: []
  - m_Id: 31095624093696
    m_Localized: "\u0422\u042B \u0414\u0415\u041B\u0410\u0415\u0428\u042C \u041E\u0422\u041B\u0418\u0427\u041D\u0423\u042E
      \u0420\u0410\u0411\u041E\u0422\u0423. \u041D\u041E \u041F\u041E\u041C\u041D\u0418
      - \u042D\u0422\u041E \u041D\u0415 \u0418\u0413\u0420\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 31194479644672
    m_Localized: "\u041C\u041E\u0429\u042C, \u0427\u0422\u041E \u0422\u042B \u0421\u041E\u0417\u0414\u0410\u0401\u0428\u042C,
      \u042D\u0422\u041E \u041E\u0422\u0412\u0415\u0422\u0421\u0422\u0412\u0415\u041D\u041D\u041E\u0421\u0422\u042C!
      \u041D\u0415 \u0414\u0410\u0419 \u0415\u0419 \u041F\u0420\u041E\u041F\u0410\u0421\u0422\u042C
      \u0417\u0420\u042F!"
    m_Metadata:
      m_Items: []
  - m_Id: 31275182247936
    m_Localized: "\u041C\u041E\u041B\u041E\u0414\u0415\u0426. \u0415\u0421\u041B\u0418
      \u041C\u041D\u0415 \u0415\u0429\u0401 \u0420\u0410\u0417 \u041F\u041E\u041D\u0410\u0414\u041E\u0411\u0418\u0422\u0421\u042F
      \u042F\u0414 - \u042F \u0417\u041D\u0410\u042E, \u041A \u041A\u041E\u041C\u0423
      \u041E\u0411\u0420\u0410\u0429\u0410\u0422\u042C\u0421\u042F!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
