  m_TableCollectionName: Text
  m_TableCollectionNameGuidString: 0942d88cecd938a4389643f525586ed3
  m_Entries:
  - m_Id: 98056589312
    m_Key: Play
    m_Metadata:
      m_Items: []
  - m_Id: 145863266304
    m_Key: Settings
    m_Metadata:
